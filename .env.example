# ── MYCELIA environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values you need.
# Never commit a .env file that contains real secrets.

# HTTP port the server listens on (default 3000)
PORT=3000

# Path to the SQLite database file (default: data/researchgraph.db)
# On Render/Railway/Fly.io, point this to a path inside your persistent disk.
RG_DB_FILE=/data/researchgraph.db

# AI providers (at least one is recommended; without both, a local heuristic
# model is used and the app labels answers "From your canvas").
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: override the OpenAI-compatible base URL (e.g. a local Ollama proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the default model for each provider
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
